# Copy to .env and edit. Never commit .env.

# Where snapshots, the SQLite metadata DB and run artifacts live (gitignored).
QUANTLAB_DATA_DIR=data

# Safety boundary: V1 has NO live broker. Setting this to true makes QuantLab refuse to start.
LIVE_TRADING_ENABLED=false

# Optional bearer token for the FastAPI backend. When set, every endpoint except /health and /docs
# requires `Authorization: Bearer <token>`. Strongly recommended if the API is reachable by others.
QUANTLAB_API_TOKEN=

# Optional LLM provider for the AI Research Assistant: none | anthropic | openai
# Without a key the assistant uses deterministic, template-based analytics.
QUANTLAB_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
